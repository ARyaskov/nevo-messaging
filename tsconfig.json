{
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "lib": ["ESNext"],
    "types": ["node"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "noImplicitAny": true
  },
  "include": ["src/**/*"],
  "//": "src/devtools-ui/client is browser JSX bundled by esbuild — see tsconfig.devtools-ui.json for its type-check",
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "examples",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/devtools-ui/client"
  ]
}
